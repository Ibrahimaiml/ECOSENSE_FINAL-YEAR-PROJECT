# Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecosense_db

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# SMTP Real Email OTP Configuration (Gmail / Outlook)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
SMTP_FROM=your_email@gmail.com

# Microsoft Entra ID Authentication (Backend Token Verification)
AZURE_CLIENT_ID=your_azure_client_id_here
AZURE_TENANT_ID=common
